# Local dashboard frontend origins. Keep these explicit; wildcards are rejected.
# Both common loopback hostnames are allowed because the shipped frontend treats
# localhost:3000 and 127.0.0.1:3000 as supported local-development origins.
ZAD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional backend settings
DEBUG=true
LOG_LEVEL=INFO
# META_API_KEY=replace-me
