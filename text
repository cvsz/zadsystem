const nav=document.getElementById('nav');
const pages=document.querySelectorAll('.page');
const buttons=nav.querySelectorAll('button');
const sidebar=document.getElementById('sidebar');
const backdrop=document.getElementById('backdrop');
const isMobile=()=>window.matchMedia('(max-width:860px)').matches;

function go(id){
  pages.forEach(p=>p.classList.toggle('active',p.id===id));
  buttons.forEach(b=>b.classList.toggle('active',b.dataset.page===id));
  document.querySelector('.main').scrollTop=0;
  if(isMobile()) closeNav();
}
buttons.forEach(b=>b.addEventListener('click',()=>{ if(b.dataset.page) go(b.dataset.page); }));
document.querySelectorAll('[data-go]').forEach(c=>c.addEventListener('click',()=>go(c.dataset.go)));

function syncBackdrop(){const open=!sidebar.classList.contains('collapsed');backdrop.classList.toggle('show', isMobile() && open);}
function toggleNav(){sidebar.classList.toggle('collapsed');syncBackdrop()}
function closeNav(){sidebar.classList.add('collapsed');syncBackdrop()}
if(isMobile()) sidebar.classList.add('collapsed');
window.addEventListener('resize',syncBackdrop);

function filterHooks(q){
  q=q.toLowerCase();
  document.querySelectorAll('#hookList .hook').forEach(h=>{
    h.style.display=h.querySelector('.text').textContent.toLowerCase().includes(q)?'':'none';
  });
}

/* ---- magic-moment toast ---- */
let toastT;
function toast(msg){var el=document.getElementById('toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastT);toastT=setTimeout(()=>el.classList.remove('show'),2200);}
document.querySelectorAll('.use').forEach(b=>b.addEventListener('click',()=>toast('ส่งเข้า /script แล้ว ✓')));
