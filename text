  .grid-3 > .card:last-child:nth-child(odd),
  .grid-2 > .card:last-child:nth-child(odd){grid-column:1 / -1}
}
@media(max-width:400px){
  .metric .value{font-size:22px}
  .summary .head h4{font-size:13px}
  .summary .meta{font-size:9.8px}
}
