  toast('เก็บเข้าคลัง HOOK แล้ว ✓');
}));
document.querySelectorAll('.actbtn').forEach(b=>b.addEventListener('click',()=>toast(b.dataset.msg||'ส่งให้ Claude แล้ว ✓')));
document.querySelectorAll('#calendar .cell').forEach(c=>{
