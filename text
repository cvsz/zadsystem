    p.classList.toggle('on');
    var pf=p.dataset.pf, on=p.classList.contains('on');
    var row=document.querySelector('.time-row[data-pf="'+pf+'"]');
    if(row) row.style.display=on?'':'none';
    var tab=document.querySelector('.captab[data-cap="'+pf+'"]');
    if(tab) tab.style.display=on?'':'none';
    refreshActiveTab();
  });
});
document.querySelectorAll('.captab').forEach(t=>{
