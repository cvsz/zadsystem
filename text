const capText=document.getElementById('capText');
function refreshActiveTab(){
  var active=document.querySelector('.captab.active');
  if(!active || active.style.display==='none'){
    var first=[...document.querySelectorAll('.captab')].find(x=>x.style.display!=='none');
    document.querySelectorAll('.captab').forEach(x=>x.classList.remove('active'));
    if(first){first.classList.add('active');capText.textContent=caps[first.dataset.cap];}
  }
}
document.querySelectorAll('.platforms .pill').forEach(p=>{
