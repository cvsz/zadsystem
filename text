});

/* ---- count-up on load ---- */
function countUp(el){
  var raw=el.textContent.trim();
  var m=raw.match(/^([^\d]*)([\d.,]+)(.*)$/);
  if(!m)return;
  var pre=m[1], numStr=m[2], suf=m[3];
  var hasComma=numStr.indexOf(',')>-1;
  var target=parseFloat(numStr.replace(/,/g,''));
  var dec=(numStr.split('.')[1]||'').length;
  var dur=950, start=performance.now();
  function fmt(v){
    var s=dec? v.toFixed(dec): Math.round(v).toString();
    if(hasComma) s=Number(s).toLocaleString('en-US',{minimumFractionDigits:dec,maximumFractionDigits:dec});
    return pre+s+suf;
  }
  function step(t){
    var p=Math.min((t-start)/dur,1), e=1-Math.pow(1-p,3);
    el.textContent=fmt(target*e);
    if(p<1) requestAnimationFrame(step); else el.textContent=raw;
  }
  requestAnimationFrame(step);
}
document.querySelectorAll('.metric .value').forEach(countUp);

/* ---- cover launcher: pick a starting page ---- */
var seenMap=false;
function startAt(id){
  var cover=document.getElementById('cover');
  go(id);
  cover.classList.add('hide');
  setTimeout(function(){cover.style.display='none';},360);

  /* first exit only: nudge + pulse. repeat visits stay quiet. */
  if(seenMap) return;
  seenMap=true;

  var nudge=document.getElementById('mapNudge');
  if(nudge){
    nudge.classList.remove('hide');
    setTimeout(function(){ nudge.classList.add('hide'); },8000);
  }
  /* draw the eye to the sidebar so they discover the other menus */
  var activeNav=document.querySelector('.nav button.active');
  var mt=document.querySelector('.menu-toggle');
  if(isMobile()){ if(mt) mt.classList.add('hint'); }
  else { if(activeNav) activeNav.classList.add('hint'); }
  setTimeout(function(){
    document.querySelectorAll('.nav button').forEach(b=>b.classList.remove('hint'));
    document.querySelectorAll('.menu-toggle').forEach(m=>m.classList.remove('hint'));
  },5500);
}

/* ---- reopen the system map from the sidebar or the topbar brand ---- */
function openMap(){
  var cover=document.getElementById('cover');
  var nudge=document.getElementById('mapNudge');
  if(nudge) nudge.classList.add('hide');
  closeInfo();
  cover.style.display='flex';
  cover.scrollTop=0;
  void cover.offsetWidth;          /* force reflow so the fade replays */
  cover.classList.remove('hide');
  if(isMobile()) closeNav();
}

